{
  "name": "universal-document-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented monorepo foundation for the Universal Document Engine.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.7.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "setup": "node tools/scripts/setup.mjs",
    "dev": "node tools/scripts/dev.mjs",
    "dev:web": "nx run web:dev",
    "dev:admin": "nx run admin:dev",
    "dev:api": "nx run api:dev",
    "infra:up": "docker compose up -d postgres minio",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres minio",
    "db:migrate": "uv run alembic -c apps/api/alembic.ini upgrade head",
    "db:revision": "uv run alembic -c apps/api/alembic.ini revision --autogenerate",
    "lint": "pnpm lint:ts && pnpm lint:py",
    "lint:ts": "nx run-many -t lint --projects=web,admin,frontend-ui,frontend-api-client,workspace-tools --parallel=3 --verbose",,
    "lint:py": "uv run ruff check apps/api libs/backend libs/engine tests && uv run mypy",
    "format": "prettier --write . && uv run ruff format apps/api libs/backend libs/engine tests",
    "format:check": "prettier --check . && uv run ruff format --check apps/api libs/backend libs/engine tests",
    "test": "pnpm test:ts && pnpm test:py",
    "test:ts": "nx run-many -t test --projects=web,admin,frontend-ui,frontend-api-client --parallel=3",
    "test:py": "uv run pytest -m \"not integration\"",
    "test:infra": "node tools/scripts/test-infra.mjs",
    "build": "pnpm build:ts && pnpm build:py",
    "build:ts": "nx run-many -t build --projects=web,admin,frontend-ui,frontend-api-client,workspace-tools --parallel=3",
    "build:py": "nx run api:build",
    "api:validate": "uv run python tools/scripts/validate_api.py",
    "compose:validate": "node tools/scripts/validate-compose.mjs",
    "check:secrets": "node tools/scripts/check-secrets.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm api:validate && pnpm check:secrets",
    "verify:foundation": "node tools/scripts/verify-foundation.mjs",
    "clean": "node tools/scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "10.0.0",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
