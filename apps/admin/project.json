{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin",
  "tags": ["scope:frontend", "type:application", "audience:admin"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "pnpm --filter @ude/admin dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "pnpm --filter @ude/admin build"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/admin"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run apps/admin"
      }
    }
  }
}
