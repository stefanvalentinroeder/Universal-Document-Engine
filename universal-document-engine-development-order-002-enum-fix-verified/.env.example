# Copy this file to .env. Values below are development-only and must be changed
# before using the stack outside an isolated local workstation.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

POSTGRES_DB=ude
POSTGRES_USER=ude
POSTGRES_PASSWORD=ude_local_only_change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ude:ude_local_only_change_me@localhost:5432/ude

MINIO_ROOT_USER=ude_minio
MINIO_ROOT_PASSWORD=ude_minio_local_only_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
